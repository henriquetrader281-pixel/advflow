INITIAL_SETUP_KEY = "SUBSTITUA_POR_UMA_CHAVE_LONGA_E_ALEATORIA"

# Persistent login storage (run supabase/schema.sql in Supabase SQL Editor first).
# Keep the real URL and secret key only in Streamlit Settings -> Secrets.
SUPABASE_URL = "https://SEU_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY = "SUA_CHAVE_SECRETA_DO_SUPABASE"
# Legacy alternative if your Supabase project still uses the old service_role key:
# SUPABASE_SERVICE_ROLE_KEY = "SUA_CHAVE_SERVICE_ROLE"
GEMINI_API_KEY = "COLE_SUA_CHAVE_AQUI"
GEMINI_MODEL = "gemini-3.8-flash"
GROQ_API_KEY = "COLE_SUA_CHAVE_ALTERNATIVA_AQUI"
GROQ_MODEL = "openai/gpt-oss-120b"
OPENROUTER_API_KEY = "COLE_SUA_CHAVE_OPENROUTER_AQUI"
OPENROUTER_MODEL = "openrouter/free"
# Optional: default image model for image generation inside Agente de conteúdo (image requests can incur charges).
OPENROUTER_IMAGE_MODEL = "google/gemini-3.1-flash-image"
OFFICE_NAME = "Nome do escritório"
OFFICE_OAB = ""
